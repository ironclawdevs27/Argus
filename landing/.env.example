# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Polar Checkout Link (optional). Create in the Polar dashboard → Products → Checkout Links
# (no API token needed — a Checkout Link is a public URL, so nothing secret enters the bundle).
# When set, the Pro pricing CTA becomes a live founding-member checkout; when empty it falls
# back to the waitlist.
#
# Polar replaced Stripe as the processor: Stripe India is invite-only and never onboarded us.
# Polar is a Merchant of Record, so it also handles global VAT/GST — there is no tax code here.
#
# NOTE: Vite inlines these at BUILD time, so set them here then rebuild + redeploy the landing.
# Set the product's success URL to https://argus-qa.com/?checkout=success so the founding-member
# thank-you toast (and the founding_members capture) fires on return.
# For a festive code to actually apply, the Polar discount must HAVE a code set — the landing
# appends `discount_code`, which only prefills code-bearing discounts.
VITE_POLAR_CHECKOUT_LINK=

# The hosted app's public origin. Used to read the live festive campaign from
# <VITE_APP_URL>/api/promos/active; any fetch failure falls back to the built-in campaign
# list, so leaving this empty is safe (the banner just stays on the compiled-in schedule).
VITE_APP_URL=https://app.argus-qa.com

# Funnel analytics (optional, deferred-on-key). Use the SAME PostHog project as the app
# (its POSTHOG_KEY) — the landing captures against an anonymous id and sends $identify at
# signup so PostHog merges the pre-signup journey into the account, giving one funnel:
#   landing_view → signup → project_created → audit_run → subscribed
# Unset ⇒ no analytics code runs at all. Global Privacy Control and Do Not Track are
# honoured, and no PII (email/name/referral code) is ever sent.
VITE_POSTHOG_KEY=
# Self-hosted / EU PostHog only; defaults to https://us.i.posthog.com
VITE_POSTHOG_HOST=
