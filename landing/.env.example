# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Stripe Payment Links (optional). Create in the Stripe dashboard → Payment Links (no API keys
# needed — just paste the resulting checkout URL). When set, the Pro/Team pricing CTA becomes a
# live founding-member checkout; when empty, it falls back to the waitlist (byte-identical to today).
# NOTE: Vite inlines these at BUILD time, so set them here then rebuild + redeploy the landing.
# Set the Payment Link's "after payment" redirect to https://argus-qa.com/?checkout=success
# to show the founding-member thank-you toast.
VITE_STRIPE_PRO_LINK=
VITE_STRIPE_TEAM_LINK=
